<?xml version="1.0"?>
<sdf version="1.6"><world name="sensors">
  <gravity>0 0 -9.81</gravity>
  <physics name="default_physics" type="ode">
    <max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
  </physics>
  <!-- Classic 11 usa heading 180 para alinhar GPS com X leste / Y norte.
       Conferir os sinais no teste de teleoperacao descrito no guia. -->
  <spherical_coordinates>
    <surface_model>EARTH_WGS84</surface_model>
    <latitude_deg>-8.05</latitude_deg><longitude_deg>-34.9</longitude_deg>
    <elevation>0</elevation><heading_deg>180</heading_deg>
  </spherical_coordinates>
  <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.8 0.9 1</background></scene>
  <light name="sun" type="directional">
    <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction>
    <cast_shadows>true</cast_shadows>
  </light>
  <model name="ground_plane"><static>true</static><link name="link">
    <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision>
    <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
      <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
    </visual>
  </link></model>
  <model name="wall_east"><static>true</static><pose>4 0 0.5 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><box><size>0.15 10 1</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>0.15 10 1</size></box></geometry>
      <material><ambient>0.9 0.3 0.2 1</ambient><diffuse>0.9 0.3 0.2 1</diffuse></material></visual>
  </link></model>
  <model name="wall_west"><static>true</static><pose>-4 0 0.5 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><box><size>0.15 10 1</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>0.15 10 1</size></box></geometry>
      <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material></visual>
  </link></model>
  <model name="wall_north"><static>true</static><pose>0 5 0.5 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><box><size>8 0.15 1</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>8 0.15 1</size></box></geometry>
      <material><ambient>0.2 0.8 0.3 1</ambient><diffuse>0.2 0.8 0.3 1</diffuse></material></visual>
  </link></model>
  <model name="wall_south"><static>true</static><pose>0 -5 0.5 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><box><size>8 0.15 1</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>8 0.15 1</size></box></geometry>
      <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.8 0.7 0.2 1</diffuse></material></visual>
  </link></model>
  <model name="box"><static>true</static><pose>2.8 2.8 0.4 0 0 0</pose><link name="link">
    <collision name="collision"><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>0.5 0.5 0.8</size></box></geometry>
      <material><ambient>0.8 0.2 0.7 1</ambient><diffuse>0.8 0.2 0.7 1</diffuse></material></visual>
  </link></model>
</world></sdf>
